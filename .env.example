# Copy this file to .env for local Docker Compose use.
# These credentials are for local development only; never use them in production.
NODE_ENV=development
PORT=3000
EXPRESS_PORT=3001
FASTIFY_PORT=3002
SWAGGER_ENABLED=true
CACHE_ENABLED=true
CACHE_REDIS_URL=redis://localhost:6379
CACHE_SERVICE_LIST_TTL_SECONDS=60
CACHE_SERVICE_DETAIL_TTL_SECONDS=120
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
TRUST_PROXY_HOPS=0

JWT_SECRET=local-only-change-this-secret-before-use

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=local-dev-db-password
DB_NAME=customer_platform
MYSQL_ROOT_PASSWORD=local-dev-root-password
MONGO_DATABASE=customer_platform

MONGO_URI=mongodb://localhost:27017/customer_platform

# Optional private S3 document storage. Use the AWS SDK default credential chain
# (for example, an ECS task role); do not store AWS access keys in this file.
# AWS_REGION=us-east-1
# S3_BUCKET=your-private-document-bucket